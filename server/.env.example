# Copia este archivo a server/.env y completa los valores reales.
# server/.env NUNCA se sube a GitHub (esta en .gitignore).

# Cadena de conexion de MongoDB Atlas (Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/novis?retryWrites=true&w=majority

# Contraseña de administrador. Cambiala por una propia -- ya NO vive
# en el codigo del frontend, solo aqui, en el servidor.
ADMIN_PASSWORD=cambia-esta-contrasena

# Puerto local del backend (Render asigna el suyo propio automaticamente
# en produccion, esta variable solo aplica para desarrollo local).
PORT=4000
